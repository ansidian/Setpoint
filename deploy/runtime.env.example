# Install privately as /srv/setpoint/runtime.env, mode 0600; never commit live values.
# Copy the EXACT production key and all still-required provider environment values.
EA_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_PRODUCTION_KEY
# Kept disabled during preparation. Set 1 only once this host should run providers.
EA_BACKGROUND_WORKERS_ENABLED=0
# Optional legacy callback fallback; stored canonical origin remains authoritative.
GOOGLE_REDIRECT_URI=https://setpoint.example.com/api/ea/accounts/gmail/callback
# Add any still-required Google client/environment credentials privately.
