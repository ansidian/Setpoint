{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "target": "ES2020",
    "tsBuildInfoFile": "./node_modules/.cache/typescript/client.tsbuildinfo",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "shared/**/*",
    "server/triage/triage-sound-settings.ts"
  ]
}
